{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "xray-core exporter dashboard: scrape health, traffic per inbound/outbound, observatory probes, xray-core runtime, and exporter self-health",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["xray", "prometheus"],
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Xray Exporter",
  "uid": "xray-exporter",
  "version": 1,
  "weekStart": "",
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "label": "Datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {},
        "regex": ""
      },
      {
        "name": "instance",
        "type": "query",
        "label": "Instance",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(xray_scrape_success, instance)",
        "query": { "query": "label_values(xray_scrape_success, instance)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": ["All"], "value": ["$__all"] }
      },
      {
        "name": "outbound",
        "type": "query",
        "label": "Outbound",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(xray_observatory_alive, tag)",
        "query": { "query": "label_values(xray_observatory_alive, tag)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": ["All"], "value": ["$__all"] }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Scrape status",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max(xray_scrape_success{instance=~\"$instance\"})",
          "legendFormat": "scrape"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red", "index": 0 },
                "1": { "text": "UP", "color": "green", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "id": 3,
      "title": "Scrape duration",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max(xray_scrape_duration_seconds{instance=~\"$instance\"})",
          "legendFormat": "duration"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Throughput (now)",
      "description": "Total inbound bidirectional throughput (uplink + downlink) across all inbound tags.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(xray_inbound_downlink_bytes_total{instance=~\"$instance\"}[$__rate_interval])) + sum(rate(xray_inbound_uplink_bytes_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "total"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "id": 5,
      "title": "Outbounds down",
      "description": "Number of observatory outbounds currently reported dead (xray_observatory_alive == 0). Green when all up.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "count(xray_observatory_alive{instance=~\"$instance\"} == 0) or vector(0)",
          "legendFormat": "down"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "id": 6,
      "title": "$outbound",
      "description": "One tile per observatory outbound: green = alive, red = down. The panel repeats over the `outbound` template variable (label_values of xray_observatory_alive), so new outbounds appear automatically.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 5 },
      "repeat": "outbound",
      "repeatDirection": "h",
      "maxPerRow": 6,
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "xray_observatory_alive{instance=~\"$instance\", tag=~\"$outbound\"}",
          "legendFormat": "{{tag}}"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "name",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "noValue": "—"
        }
      }
    },
    {
      "type": "row",
      "id": 10,
      "title": "Traffic",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }
    },
    {
      "type": "timeseries",
      "id": 11,
      "title": "Inbound throughput by tag",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(xray_inbound_uplink_bytes_total{instance=~\"$instance\"}[$__rate_interval])",
          "legendFormat": "{{tag}} ↑ up"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(xray_inbound_downlink_bytes_total{instance=~\"$instance\"}[$__rate_interval])",
          "legendFormat": "{{tag}} ↓ down"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "fillOpacity": 10, "showPoints": "never", "gradientMode": "opacity" }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "id": 12,
      "title": "Outbound throughput by tag",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(xray_outbound_uplink_bytes_total{instance=~\"$instance\"}[$__rate_interval])",
          "legendFormat": "{{tag}} ↑ up"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(xray_outbound_downlink_bytes_total{instance=~\"$instance\"}[$__rate_interval])",
          "legendFormat": "{{tag}} ↓ down"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "fillOpacity": 10, "showPoints": "never", "gradientMode": "opacity" }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "piechart",
      "id": 14,
      "title": "Outbound traffic share (downlink)",
      "description": "Share of current downlink throughput per exit outbound. Infrastructure outbounds (block / direct / dns-out) are excluded so the chart reflects real proxied egress.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 18 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (tag) (rate(xray_outbound_downlink_bytes_total{instance=~\"$instance\", tag!~\"block|direct|dns-out\"}[$__rate_interval]))",
          "legendFormat": "{{tag}}",
          "instant": true
        }
      ],
      "options": {
        "pieType": "donut",
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": { "unit": "Bps" }
      }
    },
    {
      "type": "bargauge",
      "id": 13,
      "title": "Data transferred per outbound (range, up + down)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 18 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (tag) (increase(xray_outbound_downlink_bytes_total{instance=~\"$instance\"}[$__range]) + increase(xray_outbound_uplink_bytes_total{instance=~\"$instance\"}[$__range])) > 0",
          "legendFormat": "{{tag}}",
          "instant": true
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        }
      }
    },
    {
      "type": "piechart",
      "id": 15,
      "title": "Inbound traffic share (downlink)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 26 },
      "description": "Share of current downlink throughput per inbound tag — which listener/protocol is pulling the traffic right now.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "refId": "A",
          "expr": "sum by (tag) (rate(xray_inbound_downlink_bytes_total{instance=~\"$instance\"}[$__rate_interval]))",
          "instant": true,
          "legendFormat": "{{tag}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "pieType": "donut",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": { "unit": "Bps" }
      }
    },
    {
      "type": "bargauge",
      "id": 16,
      "title": "Egress per outbound (24h, up + down)",
      "description": "Data transferred per outbound over the last 24h (up + down), independent of the dashboard time range — useful for tracking node quotas / metered plans.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 26 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (tag) (increase(xray_outbound_downlink_bytes_total{instance=~\"$instance\"}[24h]) + increase(xray_outbound_uplink_bytes_total{instance=~\"$instance\"}[24h])) > 0",
          "legendFormat": "{{tag}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        }
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      }
    },
    {
      "type": "timeseries",
      "id": 17,
      "title": "Uplink / downlink ratio per outbound",
      "description": "Uplink-to-downlink throughput ratio per exit outbound. Normal browsing is heavily download-skewed (ratio well below 1); a sustained spike toward or above 1 often means an abusive/broken tunnel or unusual upload activity.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 26 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (tag) (rate(xray_outbound_uplink_bytes_total{instance=~\"$instance\", tag!~\"block|direct|dns-out\"}[$__rate_interval])) / sum by (tag) (rate(xray_outbound_downlink_bytes_total{instance=~\"$instance\", tag!~\"block|direct|dns-out\"}[$__rate_interval]) > 0)",
          "legendFormat": "{{tag}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "fillOpacity": 10, "showPoints": "never" },
          "min": 0
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "row",
      "id": 20,
      "title": "Observatory",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 }
    },
    {
      "type": "bargauge",
      "id": 25,
      "title": "Node uptime (range)",
      "description": "Availability of each outbound over the dashboard time range (avg of xray_observatory_alive). Green tiles on the overview can hide a node that flapped for half a day — this one can't.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 35 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "avg_over_time(xray_observatory_alive{instance=~\"$instance\", tag=~\"$outbound\"}[$__range]) * 100",
          "legendFormat": "{{tag}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 99 },
              { "color": "green", "value": 99.9 }
            ]
          }
        }
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      }
    },
    {
      "type": "bargauge",
      "id": 26,
      "title": "Status flaps (range)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 35 },
      "description": "Number of up↔down transitions per outbound within the dashboard time range. Catches unstable nodes that a point-in-time status can't show.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "refId": "A",
          "expr": "changes(xray_observatory_alive{instance=~\"$instance\", tag=~\"$outbound\"}[$__range])",
          "instant": true,
          "legendFormat": "{{tag}}"
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 4 }
            ]
          },
          "unit": "short"
        }
      }
    },
    {
      "type": "table",
      "id": 27,
      "title": "Node ranking by RTT",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 35 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sort(xray_burst_observatory_rtt_average_seconds{instance=~\"$instance\", tag=~\"$outbound\"})",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "color-text" }
          },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.15 },
              { "color": "red", "value": 0.3 }
            ]
          }
        }
      },
      "options": {
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [
          { "desc": false, "displayName": "avg RTT" }
        ]
      },
      "description": "Sliding-window average RTT per outbound, best first — effectively the balancer's preference order (leastPing / leastLoad).",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true },
            "renameByName": { "Value": "avg RTT", "tag": "node" }
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 24,
      "title": "Probe delay (current)",
      "description": "Latest single-probe round-trip time per outbound (xray_observatory_probe_delay_milliseconds).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 43 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "xray_observatory_probe_delay_milliseconds{instance=~\"$instance\", tag=~\"$outbound\"}",
          "legendFormat": "{{tag}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "fillOpacity": 5, "showPoints": "never" }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "last"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "id": 21,
      "title": "Probe RTT (window average)",
      "description": "Burst-observatory sliding-window average RTT per outbound (xray_burst_observatory_rtt_average_seconds).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 43 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "xray_burst_observatory_rtt_average_seconds{instance=~\"$instance\", tag=~\"$outbound\"}",
          "legendFormat": "{{tag}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 5, "showPoints": "never" }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "last"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "id": 22,
      "title": "RTT spread (min / max / σ)",
      "description": "Burst-observatory sliding-window min, max, and standard deviation of RTT per outbound.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 51 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "xray_burst_observatory_rtt_max_seconds{instance=~\"$instance\", tag=~\"$outbound\"}",
          "legendFormat": "{{tag}} max"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "xray_burst_observatory_rtt_min_seconds{instance=~\"$instance\", tag=~\"$outbound\"}",
          "legendFormat": "{{tag}} min"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "xray_burst_observatory_rtt_deviation_seconds{instance=~\"$instance\", tag=~\"$outbound\"}",
          "legendFormat": "{{tag}} σ"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 0, "showPoints": "never" }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "id": 23,
      "title": "Health-ping failure ratio",
      "description": "Fraction of failed probes in the burst-observatory sliding window: failures / max(samples, 1).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 51 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "xray_burst_observatory_failures{instance=~\"$instance\", tag=~\"$outbound\"} / clamp_min(xray_burst_observatory_samples{instance=~\"$instance\", tag=~\"$outbound\"}, 1)",
          "legendFormat": "{{tag}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "fillOpacity": 10, "showPoints": "never" }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "type": "heatmap",
      "id": 28,
      "title": "Probe delay heatmap",
      "description": "Distribution of single-probe RTTs (all outbounds pooled) over time. Spikes, drift and multi-modality are visible at a glance where line charts get noisy.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 59 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "refId": "A",
          "expr": "xray_observatory_probe_delay_milliseconds{instance=~\"$instance\", tag=~\"$outbound\"}",
          "legendFormat": "{{tag}}"
        }
      ],
      "options": {
        "calculate": true,
        "calculation": {
          "yBuckets": { "mode": "count", "value": "24" }
        },
        "cellGap": 1,
        "color": { "mode": "scheme", "reverse": false, "scheme": "Spectral", "steps": 48 },
        "legend": { "show": true },
        "tooltip": { "mode": "single" },
        "yAxis": { "decimals": 0, "unit": "ms" }
      },
      "fieldConfig": {
        "defaults": {}
      }
    },
    {
      "type": "timeseries",
      "id": 29,
      "title": "Failed probes (sliding window)",
      "description": "Absolute number of failed health probes per outbound in the burst-observatory sliding window (xray_burst_observatory_failures). Complements the ratio panel: a node with few samples can show a scary ratio from one failure, and this shows the raw count. The metric is a gauge — old failures drop out of the window — so it is plotted as-is, not through rate().",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 59 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "refId": "A",
          "expr": "xray_burst_observatory_failures{instance=~\"$instance\", tag=~\"$outbound\"}",
          "legendFormat": "{{tag}}"
        }
      ],
      "options": {
        "legend": { "calcs": ["max", "last"], "displayMode": "table", "placement": "right" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "axisLabel": "failed probes",
            "fillOpacity": 10,
            "showPoints": "never",
            "lineInterpolation": "stepAfter"
          },
          "min": 0,
          "unit": "short",
          "decimals": 0
        }
      }
    },
    {
      "type": "row",
      "id": 40,
      "title": "Exporter self-health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 67 }
    },
    {
      "type": "timeseries",
      "id": 41,
      "title": "Goroutines (exporter)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 68 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "go_goroutines{instance=~\"$instance\"} and on(instance, job) xray_exporter_build_info",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 5, "showPoints": "never" }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "type": "timeseries",
      "id": 42,
      "title": "Resident memory (exporter)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 68 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "process_resident_memory_bytes{instance=~\"$instance\"} and on(instance, job) xray_exporter_build_info",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "custom": { "fillOpacity": 5, "showPoints": "never" }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "type": "timeseries",
      "id": 43,
      "title": "CPU (exporter)",
      "description": "Exporter process CPU usage in cores (rate of process_cpu_seconds_total). 1.0 = one full core.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 68 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(process_cpu_seconds_total{instance=~\"$instance\"}[$__rate_interval]) and on(instance, job) xray_exporter_build_info",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "fillOpacity": 10, "showPoints": "never" }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "type": "table",
      "id": 44,
      "title": "Build info (exporter)",
      "description": "xray_exporter_build_info — version, revision and Go toolchain the exporter was built with.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 68 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "xray_exporter_build_info{instance=~\"$instance\"}",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Value": true, "__name__": true, "job": true },
            "indexByName": {},
            "renameByName": {}
          }
        }
      ],
      "options": { "showHeader": true },
      "fieldConfig": {
        "defaults": {}
      }
    },
    {
      "type": "timeseries",
      "id": 45,
      "title": "Open file descriptors (exporter)",
      "description": "Open file descriptors of the exporter process. A steady climb means leaked connections to the xray API.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 76 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "refId": "A",
          "expr": "process_open_fds{instance=~\"$instance\"} and on(instance, job) xray_exporter_build_info",
          "legendFormat": "open fds"
        }
      ],
      "options": {
        "legend": { "calcs": ["last", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 10, "showPoints": "never" },
          "min": 0,
          "unit": "short"
        }
      }
    },
    {
      "type": "stat",
      "id": 46,
      "title": "Process uptime (exporter)",
      "description": "Time since the exporter process started. A low value means a recent restart or crash.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 76 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "refId": "A",
          "expr": "time() - (process_start_time_seconds{instance=~\"$instance\"} and on(instance, job) xray_exporter_build_info)",
          "instant": true,
          "legendFormat": "uptime"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 900 },
              { "color": "green", "value": 3600 }
            ]
          },
          "unit": "dtdurations"
        }
      }
    },
    {
      "type": "state-timeline",
      "id": 47,
      "title": "Scrape success history",
      "description": "History of xray API scrape success — red segments mark windows where the exporter could not reach xray. The overview stat only shows the current state.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 76 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "refId": "A",
          "expr": "max(xray_scrape_success{instance=~\"$instance\"})",
          "legendFormat": "xray api scrape"
        }
      ],
      "options": {
        "legend": { "displayMode": "hidden", "placement": "bottom" },
        "mergeValues": true,
        "rowHeight": 0.85,
        "showValue": "never",
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 70, "lineWidth": 0 },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "color": "red", "text": "FAIL" },
                "1": { "color": "green", "text": "OK" }
              }
            }
          ],
          "max": 1,
          "min": 0
        }
      }
    },
    {
      "type": "row",
      "id": 30,
      "title": "xray-core runtime (memstats)",
      "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 84 },
      "panels": [
        {
          "type": "timeseries",
          "id": 31,
          "title": "Heap memory",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 85 },
          "targets": [
            {
              "refId": "A",
              "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
              "expr": "xray_memstats_heap_alloc_bytes{instance=~\"$instance\"}",
              "legendFormat": "heap alloc"
            },
            {
              "refId": "B",
              "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
              "expr": "xray_memstats_heap_inuse_bytes{instance=~\"$instance\"}",
              "legendFormat": "heap in-use"
            },
            {
              "refId": "C",
              "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
              "expr": "xray_memstats_sys_bytes{instance=~\"$instance\"}",
              "legendFormat": "sys"
            },
            {
              "refId": "D",
              "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
              "expr": "xray_memstats_next_gc_bytes{instance=~\"$instance\"}",
              "legendFormat": "next GC target"
            },
            {
              "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
              "refId": "E",
              "expr": "xray_memstats_heap_released_bytes{instance=~\"$instance\"}",
              "legendFormat": "released to OS"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "decbytes",
              "custom": { "fillOpacity": 5, "showPoints": "never" }
            }
          },
          "options": {
            "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last"] },
            "tooltip": { "mode": "multi", "sort": "desc" }
          }
        },
        {
          "type": "timeseries",
          "id": 32,
          "title": "GC pause rate & CPU fraction",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "gridPos": { "h": 8, "w": 12, "x": 12, "y": 85 },
          "targets": [
            {
              "refId": "A",
              "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
              "expr": "rate(xray_memstats_gc_pause_seconds_total{instance=~\"$instance\"}[$__rate_interval])",
              "legendFormat": "GC pause (s/s)"
            },
            {
              "refId": "B",
              "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
              "expr": "xray_memstats_gc_cpu_fraction{instance=~\"$instance\"}",
              "legendFormat": "GC CPU fraction"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "percentunit",
              "custom": { "fillOpacity": 10, "showPoints": "never" }
            }
          },
          "options": {
            "legend": { "displayMode": "list", "placement": "bottom" },
            "tooltip": { "mode": "multi" }
          }
        },
        {
          "type": "timeseries",
          "id": 33,
          "title": "GC frequency",
          "description": "Garbage-collection frequency of xray-core (runs per minute). A rising trend means growing allocation pressure.",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 93 },
          "targets": [
            {
              "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
              "refId": "A",
              "expr": "rate(xray_memstats_num_gc_total{instance=~\"$instance\"}[$__rate_interval]) * 60",
              "legendFormat": "GC runs / min"
            }
          ],
          "options": {
            "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
            "tooltip": { "mode": "multi" }
          },
          "fieldConfig": {
            "defaults": {
              "custom": { "fillOpacity": 10, "showPoints": "never" },
              "min": 0,
              "unit": "short"
            }
          }
        },
        {
          "type": "timeseries",
          "id": 34,
          "title": "Live heap objects",
          "description": "Objects currently live on the xray-core heap (mallocs − frees). A steady climb without matching traffic growth is the classic leak signature.",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "gridPos": { "h": 8, "w": 12, "x": 12, "y": 93 },
          "targets": [
            {
              "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
              "refId": "A",
              "expr": "xray_memstats_mallocs_total{instance=~\"$instance\"} - xray_memstats_frees_total{instance=~\"$instance\"}",
              "legendFormat": "live objects"
            }
          ],
          "options": {
            "legend": { "calcs": ["last", "max"], "displayMode": "table", "placement": "bottom" },
            "tooltip": { "mode": "multi" }
          },
          "fieldConfig": {
            "defaults": {
              "custom": { "fillOpacity": 10, "showPoints": "never" },
              "min": 0,
              "unit": "short"
            }
          }
        }
      ]
    }
  ]
}
